# ==============================================================================
# OmniKeep Environment Configuration
# ==============================================================================
# Only the core service block below is required. AI connections, bot tokens,
# the GitHub token and backups are entered in the web app (avatar menu at the
# top right → 設定); values saved there win over this file and apply without a
# restart. The lines that are commented out show the built-in defaults: leave
# them as they are unless you want this file, not the app, to hold the value.
# Credentials saved in the app are encrypted with omnikeep.secret.key, created
# next to the database (or set OMNIKEEP_SECRET_KEY). Keep that file out of git.

# ── Core Service ─────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=5000
# Docker host binding: localhost only by default; set 0.0.0.0 for deliberate LAN access.
BIND_ADDRESS=127.0.0.1
# Docker image build: true adds on-device speech-to-text (docs/optional_features.md).
LOCAL_STT=false
# A browser on this same computer signs in without the access key (on by default).
# Every other device always needs the key or a one-time pairing code. Switch it off
# in the web app (設定 → 進階 → 這台電腦免登入) or by uncommenting the next line;
# a value saved in the app wins over this file.
# LOCAL_AUTO_LOGIN=false

# API_KEY: access key (sign-in from other devices, REST API & MCP bearer token)
# At least 32 characters, with at least 12 different characters.
# Do not fill it in by hand: `python scripts/bootstrap_env.py` creates .env from this
# file with a random key (the installers run it). To replace the key of an existing
# .env later: `python scripts/rotate_api_key.py`.
API_KEY=

# ── AI (optional here: connect one in the app, 設定 → AI) ────────────────────
# No AI is needed to start: links are saved without an analysis ("尚未分析") and
# analysed once a connection exists. The values below are the older flat settings;
# the first start turns whatever is set here into AI connections.
# OpenAI-compatible endpoint (OpenAI, DeepSeek, Groq, Ollama's /v1, vLLM ...):
#   OpenAI:    https://api.openai.com/v1          (model: gpt-4o, gpt-4o-mini)
#   DeepSeek:  https://api.deepseek.com/v1        (model: deepseek-chat)
#   Groq:      https://api.groq.com/openai/v1     (model: llama-3.3-70b-versatile)
#   Ollama:    http://localhost:11434/v1          (model: llama3.1, qwen2.5)
# PRIMARY_LLM_PROVIDER=openai_compatible
# OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
# PRIMARY_MODEL=gpt-4o-mini

# Google Gemini (also analyses YouTube videos). Several keys, comma-separated, take turns.
GEMINI_API_KEYS=
# GEMINI_MODEL=gemini-2.5-flash

# ── Semantic Search Embeddings ───────────────────────────────────────────────
# Tried in order: local Ollama (OLLAMA_BASE_URL + EMBEDDING_MODEL), then the
# OpenAI-compatible endpoint above (embeddinggemma-2 maps to text-embedding-3-small
# there), then a local hash. Set OLLAMA_BASE_URL= (blank) to skip Ollama.
# After changing either, re-index: python scripts/rebuild_embeddings.py
# EMBEDDING_MODEL=embeddinggemma-2
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# ── 提問 (answers from your collection, with the items it cites) ─────────────
# Local Ollama model first, then the analysis connection.
# BRAIN_PROVIDER=ollama
# BRAIN_BASE_URL=http://127.0.0.1:11434
# BRAIN_MODEL=qwen3:8b

# ── Storage & Local Database ─────────────────────────────────────────────────
DATABASE_PATH=omnikeep.db

# ── Telegram Private Ingestion Bot (Optional) ────────────────────────────────
# Easier in the web app: 設定 → 收錄管道 → Telegram (docs/telegram_bot.md).
# 1. Talk to @BotFather on Telegram to create your bot and obtain TELEGRAM_BOT_TOKEN
# 2. Bind your account: in the web app open 設定 → 收錄管道 → Telegram, press
#    「產生配對連結」 and open the one-time link in Telegram (the account is saved in
#    the app), or message the bot to get your numerical User ID and paste it below.
#    Nobody is bound just for messaging it.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# ── LINE Messaging API Bot (Optional) ────────────────────────────────────────
# Retrieve Channel Secret & Access Token from LINE Developers Console
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_ALLOWED_USER_IDS=

# ── PWA Web Push Notifications (Optional) ────────────────────────────────────
# Leave empty: OmniKeep generates a pair on first start and keeps it, encrypted, in the app's
# settings. A pair set here is used instead (python scripts/generate_vapid_keys.py fills both).
# Replacing the pair invalidates every existing browser subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact sent to push services: a mailto: address or https URL (defaults to the project URL).
# VAPID_SUBJECT=mailto:you@example.com

# ── LLM Rate-Limit Protection & Concurrency ──────────────────────────────────
# Client-side pacing: minimum seconds between request starts (adapts up on HTTP 429)
# LLM_MIN_REQUEST_INTERVAL=2.5
# Maximum parallel in-flight LLM requests
# LLM_MAX_CONCURRENCY=2

# ── 探索 (experimental, off by default: 設定 → 實驗功能) ─────────────────────
# Background checks are switched on, and their interval set, in the app's 探索
# settings. New installs start with them off.
# GitHub Personal Access Token (optional, raises rate limits for GitHub sources)
GITHUB_TOKEN=

# ── Automated Multi-Sink Daily Backups ────────────────────────────────────────
# local  = Rotating local snapshots (default, zero extra setup; retains BACKUP_KEEP copies)
# rclone = Sync to cloud storage (Google Drive, Dropbox, S3, WebDAV) via rclone
# git    = Auto-commit to a local clone of a private git repository
# off    = Disable backups
BACKUP_SINK=local
BACKUP_DIR=backups
BACKUP_KEEP=14
BACKUP_RCLONE_REMOTE=
BACKUP_GIT_REPO_DIR=
BACKUP_HOUR=4
