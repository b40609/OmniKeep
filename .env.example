# OmniKeep Service Configuration
HOST=0.0.0.0
PORT=5000
API_KEY=omnifs888

# Primary LLM Provider (Standard OpenAI Compatible API)
# Perfect for Agnes AI, DeepSeek, Native OpenAI, Groq, or Local Ollama
PRIMARY_LLM_PROVIDER=openai_compatible
OPENAI_BASE_URL=https://platform.agnes-ai.com/v1
OPENAI_API_KEY=your_agnes_or_openai_api_key_here
PRIMARY_MODEL=gpt-4o

# Google Gemini API Keys (For Native YouTube Analysis & Multimodal)
# Supports multiple comma-separated keys for automatic round-robin pooling: key1,key2,key3
GEMINI_API_KEYS=your_gemini_pro_key_1,your_gemini_pro_key_2,your_gemini_pro_key_3
GEMINI_MODEL=gemini-2.5-flash

# Database Settings
DATABASE_PATH=omnikeep.db

# Telegram Private Ingest Bot
# Get your token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
# Your Telegram User ID (comma-separated if multiple, e.g. 12345678,87654321)
TELEGRAM_ALLOWED_USER_IDS=

# LINE Messaging API Private Ingest Bot
# Get Channel Secret & Access Token from LINE Developers Console
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# Your LINE User ID (starts with U..., comma-separated if multiple)
LINE_ALLOWED_USER_IDS=
