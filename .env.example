# ==============================================================================
# OmniKeep Environment Configuration
# ==============================================================================

# ── Core Service ─────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=5000
# Docker host binding: localhost only by default; set 0.0.0.0 for deliberate LAN access.
BIND_ADDRESS=127.0.0.1
# Require explicit login on first install; loopback auto-login is opt-in.
LOCAL_AUTO_LOGIN=false

# API_KEY: Master access key (Web dashboard login, REST API & MCP bearer token)
# Must be >= 32 characters.
# Generate automatically via: python scripts/rotate_api_key.py
API_KEY=

# ── Primary LLM Provider (OpenAI-Compatible Endpoint) ────────────────────────
# Compatible with OpenAI, DeepSeek, Groq, Moonshot, Ollama, vLLM, etc.
# Examples:
#   OpenAI:    https://api.openai.com/v1          (model: gpt-4o, gpt-4o-mini)
#   DeepSeek:  https://api.deepseek.com/v1        (model: deepseek-chat)
#   Groq:      https://api.groq.com/openai/v1     (model: llama-3.3-70b-versatile)
#   Ollama:    http://localhost:11434/v1          (model: llama3.1, qwen2.5)
PRIMARY_LLM_PROVIDER=openai_compatible
OPENAI_BASE_URL=https://api.openai.com/v1
# Optional: required only for AI summarization (basic bookmark import works without it).
OPENAI_API_KEY=
PRIMARY_MODEL=gpt-4o-mini

# ── Google Gemini Provider (Native YouTube Video & Multimodal Processing) ───
# Supports multiple comma-separated keys for automatic round-robin pooling: key1,key2,key3
# Gemini 2.5 Flash natively digests YouTube streams without local bandwidth/download overhead.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-2.5-flash

# ── Storage & Local Database ─────────────────────────────────────────────────
DATABASE_PATH=omnikeep.db

# ── Telegram Private Ingestion Bot (Optional) ────────────────────────────────
# 1. Talk to @BotFather on Telegram to create your bot and obtain TELEGRAM_BOT_TOKEN
# 2. Start your bot; it will output your numerical User ID
# 3. Paste your User ID below to restrict access exclusively to yourself
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# ── LINE Messaging API Bot (Optional) ────────────────────────────────────────
# Retrieve Channel Secret & Access Token from LINE Developers Console
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_ALLOWED_USER_IDS=

# ── LLM Rate-Limit Protection & Concurrency ──────────────────────────────────
# Client-side pacing: minimum seconds between request starts (adapts up on HTTP 429)
LLM_MIN_REQUEST_INTERVAL=2.0
# Maximum parallel in-flight LLM requests
LLM_MAX_CONCURRENCY=2

# ── Information Radar Engine ─────────────────────────────────────────────────
# Opt in after setting up providers and choosing your information sources.
RADAR_ENABLED=false
# Polling interval in seconds (default 10800s = 3 hours)
RADAR_INTERVAL_SECONDS=10800
# GitHub Personal Access Token (optional, raises rate limits for GitHub Trending)
GITHUB_TOKEN=

# ── Automated Multi-Sink Daily Backups ────────────────────────────────────────
# local  = Rotating local snapshots (default, zero extra setup; retains BACKUP_KEEP copies)
# rclone = Sync to cloud storage (Google Drive, Dropbox, S3, WebDAV) via rclone
# git    = Auto-commit to a local clone of a private git repository
# off    = Disable backups
BACKUP_SINK=local
BACKUP_DIR=backups
BACKUP_KEEP=14
BACKUP_RCLONE_REMOTE=
BACKUP_GIT_REPO_DIR=
BACKUP_HOUR=4
